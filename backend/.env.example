# ==========================================================
# TruthGuard - Environment Configuration
# ==========================================================

# Application Settings
APP_ENV=development
DEBUG=true
PROJECT_NAME="TruthGuard"
API_V1_STR="/api/v1"
SECRET_KEY="truthguard-development-secret-key-change-in-production"

# Database Configuration (Falls back to SQLite if empty or unavailable)
DATABASE_URL=sqlite:///./truthguard.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/truthguard

# Vector Storage
VECTOR_DB_URL=
VECTOR_COLLECTION_NAME=truthguard_evidence

# Mock Mode (Set to true to run deterministic local verification without external APIs)
MOCK_MODE=true

# LLM Provider Configuration (OpenAI, Groq, Together, Ollama, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Search Provider Configuration (Tavily, Serper, etc.)
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# NLI Model
NLI_MODEL=cross-encoder/nli-deberta-v3-small

# Knowledge Graph
WIKIDATA_ENABLED=true
LOCAL_KG_PATH=data/knowledge_graph/facts.json

# Performance & Guardrails
REQUEST_TIMEOUT_SECONDS=5.0
MAX_INPUT_LENGTH=10000
RETENTION_ENABLED=false

# Domain Threshold Defaults (Configurable via JSON string or defaults in config.py)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# SMS Gateway Configuration (Twilio for real cellular SMS delivery to mobile phones)
# If left blank, verification OTPs run in development simulation mode.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Alternative Generic HTTP SMS Gateway (e.g. Fast2SMS / Msg91 / TextLocal)
SMS_GATEWAY_URL=
SMS_API_KEY=
